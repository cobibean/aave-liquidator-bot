# Chain Selection
CHAINS=plasma,arbitrum,base,avalanche,optimism

# Optional single-chain override
# CHAIN=arbitrum

# Optional RPC overrides. Use comma-separated fallbacks.
# ARBITRUM_RPC_URLS=https://...
# RPC_URLS=https://...

# Contract Addresses
# PLASMA_AAVE_LIQUIDATOR_ADDRESS=0x...
# ARBITRUM_AAVE_LIQUIDATOR_ADDRESS=0x...
# BASE_AAVE_LIQUIDATOR_ADDRESS=0x...
# AVALANCHE_AAVE_LIQUIDATOR_ADDRESS=0x...
# OPTIMISM_AAVE_LIQUIDATOR_ADDRESS=0x...

# Bot Configuration
LIQUIDATION_THRESHOLD=1.0
MIN_DEBT_TO_COVER=0.099
GAS_PRICE_BUMP_GWEI=0

# Scan loop cadence (ms). Each cycle does an incremental Borrow scan + a
# parallel health-factor sweep, so it is cheap enough to run frequently.
SCAN_INTERVAL_MS=15000

# How many health-factor RPC calls to run in parallel per cycle.
# Higher = faster sweeps, but watch public-RPC rate limits.
HF_CHECK_CONCURRENCY=25

# One-time borrower backfill depth, in blocks, per chain. Built once and
# persisted under data/borrowers-<chain>.json, then updated incrementally.
# Defaults (~30 days) live in src/chains.js; override per chain if needed.
# Deeper = more historical borrowers discovered, but a longer first run.
# PLASMA_BORROW_BACKFILL_BLOCKS=2592000
# ARBITRUM_BORROW_BACKFILL_BLOCKS=10368000
# BASE_BORROW_BACKFILL_BLOCKS=1296000
# AVALANCHE_BORROW_BACKFILL_BLOCKS=1296000
# OPTIMISM_BORROW_BACKFILL_BLOCKS=1296000

# Where the persisted borrower sets are stored (default: ./data).
# BORROWER_STORE_DIR=./data

# Security (NEVER COMMIT THESE!)
PRIVATE_KEY=

# Optional: Set to true for test mode (no actual transactions)
TEST_MODE=true 
VERBOSE_HEALTH_LOGS=false

# DigitalOcean deployment target
DIGITALOCEAN_API_TOKEN=
DIGITALOCEAN_DROPLET_NAME=

# Optional: SSH fallback for disk/RAM room checks when DO Monitoring has no samples.
DROPLET_SSH_USER=root
DROPLET_SSH_KEY_PATH=
DROPLET_SSH_PORT=22
DROPLET_APP_DIR=/opt/aave-liquidator-bot
DROPLET_MIN_FREE_MB=1024
DROPLET_MIN_MEM_AVAILABLE_MB=256
