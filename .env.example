# Chain Selection
CHAINS=plasma,arbitrum,base,avalanche,optimism

# Optional single-chain override
# CHAIN=arbitrum

# Optional RPC overrides. Use comma-separated fallbacks.
# ARBITRUM_RPC_URLS=https://...
# RPC_URLS=https://...

# Optional WebSocket endpoints (Batch 1.2). Used ONLY for push-based block events
# when BLOCK_TRIGGER=true; all reads/sends still go over the HTTP rpc urls above.
# Strongly recommended (private/WS, e.g. Alchemy/Infura) before enabling the
# per-block trigger across multiple chains — public HTTP polling will throttle.
# Per chain: <CHAIN>_WS_URL. Single-chain (CHAIN=...) mode: WS_URL.
# ARBITRUM_WS_URL=wss://...
# BASE_WS_URL=wss://...
# AVALANCHE_WS_URL=wss://api.avax.network/ext/bc/C/ws
# OPTIMISM_WS_URL=wss://...
# PLASMA_WS_URL=wss://...

# Per-block watchlist trigger (Batch 1.1). Off by default. When "true", each
# chain re-checks ONLY its watchlist (near-threshold, non-dust wallets) on every
# new block via Multicall3, so a position crossing HF<1 is acted on within ~1
# block instead of up to SCAN_INTERVAL_MS later. Uses a WS endpoint if one is
# configured above (push), else falls back to HTTP block polling. The 15s poll
# still runs alongside it to maintain the watchlist (full/warm/cold sweeps); a
# shared per-chain guard ensures the two never run concurrently. Honors TEST_MODE.
BLOCK_TRIGGER=false

# Contract Addresses
# PLASMA_AAVE_LIQUIDATOR_ADDRESS=0x...
# ARBITRUM_AAVE_LIQUIDATOR_ADDRESS=0x...
# BASE_AAVE_LIQUIDATOR_ADDRESS=0x...
# AVALANCHE_AAVE_LIQUIDATOR_ADDRESS=0x...
# OPTIMISM_AAVE_LIQUIDATOR_ADDRESS=0x...

# Bot Configuration
LIQUIDATION_THRESHOLD=1.0
MIN_DEBT_TO_COVER=0.099      # secondary per-asset floor (token units); USD floor below is primary
GAS_PRICE_BUMP_GWEI=0        # added to the priority fee (1559) or gasPrice (legacy)

# Gas bidding (3.1, EIP-1559). When the chain exposes a 1559 fee market (all 5 do),
# the bot bids on INCLUSION PRIORITY so it can beat a competitor's tx in the same
# block. The priority fee is driven by the BASE FEE (the real congestion signal on
# these L2s) — NOT the node's "suggested tip", which is a flat ~1.5 gwei regardless
# of load and caused ~2.25 gwei overpay on a near-zero base fee. Formula:
#   priorityFee = clamp(baseFee × PRIORITY_FEE_MULTIPLE,
#                       MIN_PRIORITY_FEE_GWEI floor, MAX_PRIORITY_FEE_GWEI cap)
#                 + GAS_PRICE_BUMP_GWEI
#   maxFeePerGas = baseFee × BASE_FEE_MULTIPLE + priorityFee
# So the tip scales with congestion, collapses to the floor when quiet (still
# out-tips lazy bots), and can't exceed the cap on a base-fee spike. Overpaying to
# win is fine on a profitable liquidation (the minProfit floor budgets
# PROFIT_SAFETY_MULTIPLE × gas, callStatic gates losses) — this just stops needless
# overpay. ALL FOUR are per-chain overridable: <CHAIN>_PRIORITY_FEE_MULTIPLE,
# <CHAIN>_BASE_FEE_MULTIPLE, <CHAIN>_MIN_PRIORITY_FEE_GWEI, <CHAIN>_MAX_PRIORITY_FEE_GWEI.
# NOTE: PRIORITY_FEE_MULTIPLE is now relative to BASE FEE (was suggested-tip).
# Raise <CHAIN>_MAX_PRIORITY_FEE_GWEI if you need to win harder on a congested chain.
# Force legacy gas via <CHAIN>.forceLegacyGas in chains.js if a chain misreports 1559.
PRIORITY_FEE_MULTIPLE=3
BASE_FEE_MULTIPLE=2
MIN_PRIORITY_FEE_GWEI=0.05
MAX_PRIORITY_FEE_GWEI=2.25

# Submission (3.2). The bot tracks the nonce locally (seeded once from the pending
# count) so back-to-back sends don't round-trip getTransactionCount or collide.
# ASYNC_SEND=true stops blocking on tx.wait() before the next target (fire, confirm
# out-of-band) — needed to act on multiple same-block targets. MAX_INFLIGHT_TX caps
# concurrent unconfirmed txs per chain (default 1 = the proven one-at-a-time path;
# raise it together with ASYNC_SEND). Defaults preserve current behavior.
ASYNC_SEND=false
MAX_INFLIGHT_TX=1

# Skip positions whose total debt is under this many USD. Most on-chain
# liquidations are sub-$100 dust where gas exceeds the bonus; this is the
# primary "is it worth doing" filter (uses Aave totalDebtBase, USD).
# Per-chain override: <CHAIN>_MIN_DEBT_USD (e.g. AVALANCHE_MIN_DEBT_USD=10,
# OPTIMISM_MIN_DEBT_USD=10) lets cheap chains work smaller positions without
# lowering the floor on Base/Arbitrum. Falls back to MIN_DEBT_USD when unset.
MIN_DEBT_USD=100
# AVALANCHE_MIN_DEBT_USD=10
# OPTIMISM_MIN_DEBT_USD=10

# Scan loop cadence (ms). Each cycle does an incremental Borrow scan + a
# stratified Multicall3 health-factor sweep, so it is cheap to run often.
SCAN_INTERVAL_MS=15000

# Health-factor sweep tuning.
# WATCHLIST_HF: wallets below this HF (and >= MIN_DEBT_USD debt) are re-checked
#   every cycle. FULL_SWEEP_EVERY_N: do a full-set sweep this often to refresh
#   the watchlist. MULTICALL_BATCH_SIZE: getUserAccountData calls per multicall.
# The full sweep STREAMS batches (peak heap ~130 MB even at Base's ~210k
#   borrowers) instead of materializing all results — this is what prevents the
#   Node heap OOM. SWEEP_CHECKPOINT_BATCHES: during a full sweep, persist the
#   partial watchlist every this-many batches so a mid-sweep crash resumes with
#   the near-threshold wallets found so far (and still redoes the full sweep).
WATCHLIST_HF=1.25
FULL_SWEEP_EVERY_N=20
MULTICALL_BATCH_SIZE=300
SWEEP_CHECKPOINT_BATCHES=50
HF_CHECK_CONCURRENCY=25       # (legacy; sweep now uses Multicall3, not this)

# Candidate enrichment (Batch 2.2). Each unhealthy candidate's per-reserve
# debt/collateral reads are collapsed into ONE Multicall3 batch, and candidates
# are enriched CONCURRENTLY (not one-at-a-time). ENRICH_CONCURRENCY caps how many
# candidates are enriched in parallel. RESERVES_CACHE_TTL_MS caches the reserves
# list (changes only on Aave listings) so it isn't re-fetched per candidate.
ENRICH_CONCURRENCY=10
RESERVES_CACHE_TTL_MS=300000

# Oracle price cache (Batch 2.1). The gas-aware min-profit floor reads the Aave
# oracle for native + debt prices; these are cached this many ms (Chainlink feeds
# move on heartbeats, so a few seconds of staleness is safe) to drop 2 reads from
# nearly every attempt in a burst.
ORACLE_PRICE_TTL_MS=5000

# Active-debt index (Layer 2). The "full" sweep iterates only wallets observed
# carrying debt (active-debt-<chain>.json), not every ever-borrowed wallet —
# Base has ~210k ever-borrowed but only a few thousand with debt now, so this
# keeps the full sweep fast enough to run often. COLD_SWEEP_EVERY_N: every this
# many "warm" (active-debt) sweeps, do one "cold" sweep of the ENTIRE borrower
# set to rebuild the index (catch wallets that took on debt without a Borrow
# event we'd see incrementally). New borrowers are added to the index each cycle.
COLD_SWEEP_EVERY_N=8

# Profitability floor (gas-aware). On hardened contracts the bot passes a
# per-call min profit = MIN_PROFIT_USD + PROFIT_SAFETY_MULTIPLE × live gas cost,
# computed from the Aave oracle. The contract reverts if a swap can't clear it.
MIN_PROFIT_USD=1
PROFIT_SAFETY_MULTIPLE=2

# Borrower backfill: one-time deep scan of Borrow events from each pool's
# deployment block, persisted under data/ then updated incrementally every cycle.
# borrowBackfillBlocks in src/chains.js acts as a MAX-DEPTH CAP (Avalanche/Optimism
# are capped to ~366 days; others reach full deployment). Override per chain:
# BORROW_BACKFILL_FROM_DEPLOYMENT=true   # set false to use the rolling window only
# AVALANCHE_BORROW_BACKFILL_BLOCKS=15811200
# OPTIMISM_BORROW_BACKFILL_BLOCKS=15811200
# CHECKPOINT_EVERY_CHUNKS=25             # backfill progress save cadence (resume)

# Where the persisted borrower sets are stored (default: ./data, a docker volume).
# BORROWER_STORE_DIR=./data

# Security (NEVER COMMIT THESE!)
PRIVATE_KEY=

# Optional: Set to true for test mode (no actual transactions)
TEST_MODE=true 
VERBOSE_HEALTH_LOGS=false

# DigitalOcean deployment target
DIGITALOCEAN_API_TOKEN=
DIGITALOCEAN_DROPLET_NAME=

# Optional: SSH fallback for disk/RAM room checks when DO Monitoring has no samples.
DROPLET_SSH_USER=root
DROPLET_SSH_KEY_PATH=
DROPLET_SSH_PORT=22
DROPLET_APP_DIR=/opt/aave-liquidator-bot
DROPLET_MIN_FREE_MB=1024
DROPLET_MIN_MEM_AVAILABLE_MB=256

# Private monitor dashboard (non-secret)
# Host-side localhost port used by docker-compose.yml.
MONITOR_PORT=8787
MONITOR_BOT_CONTAINER=aave-liquidator
MONITOR_STATUS_LOG_WINDOW=12h
MONITOR_STALE_LOG_MINUTES=30
MONITOR_MAX_LOG_LINES=2000
